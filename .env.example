# Copy this file to .env and fill in your values.
# Never commit .env to git.

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Gmail SMTP (required for Forgot Password OTP emails) ---
# 1. Enable 2-Step Verification on your Google account.
# 2. Generate an App Password: Google Account → Security → App Passwords.
# 3. Fill in your Gmail address and the 16-character App Password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# Optional: override the From display address (defaults to SMTP_USER)
# SMTP_FROM=EcoPulse AI <your_gmail_address@gmail.com>
